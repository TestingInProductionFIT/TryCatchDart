# Optional udev rule so non-root users can open USB serial adapters
# without manual group tweaks on most distros.
# Install manually: sudo cp 69-trycatch-serial.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules
# CachyOS/Arch users: ensure your user is in the `uucp` group instead:
#   sudo usermod -aG uucp $USER   (log out/in), or use the AppImage as-is
#   with adapters that already ship rules (most CP210x/CH340/FTDI boards).
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", MODE="0666", GROUP="uucp", TAG+="uaccess"
